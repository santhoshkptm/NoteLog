<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.simplejournal"
    android:versionCode="9"
    android:versionName="1.4.3" >

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="NoteLog"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme" >
        <activity
            android:name="com.example.simplejournal.EditorActivity"
            android:exported="false" />
        <activity
            android:name="com.example.simplejournal.AboutActivity"
            android:exported="false" />
        <activity
            android:name="com.example.simplejournal.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>